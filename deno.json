{
  "name": "nemesis",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-all src/main.ts",
    "scan": "deno run --allow-all src/main.ts --all",
    "compile": "deno compile --allow-all --output bin/nemesis src/main.ts",
    "compile:linux": "deno compile --allow-all --target x86_64-unknown-linux-gnu --output bin/nemesis-linux src/main.ts",
    "compile:windows": "deno compile --allow-all --target x86_64-pc-windows-msvc --output bin/nemesis-windows.exe src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@actions/core": "npm:@actions/core@^1.11.1",
    "@actions/github": "npm:@actions/github@^6.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.5/colors",
    "@std/fs": "jsr:@std/fs@^1.0.11",
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "compilerOptions": {
    "strict": true
  }
}
